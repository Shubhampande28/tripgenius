{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // automation/ is excluded: those scripts run via tsx in GitHub Actions with
  // their own module/target settings, plus one devDependency (cheerio) not
  // installed in the app's production dependencies — `next build` must not
  // typecheck them. (satori/@resvg/resvg-js moved to dependencies — the
  // Pinterest renderer is now also called from /admin/pinterest at runtime,
  // not just from CI.) automation/ has its own tsconfig
  // (automation/tsconfig.json), checked via `npm run check:automation`.
  "exclude": ["node_modules", "automation"]
}
